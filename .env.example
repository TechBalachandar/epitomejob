# EpitomeJob W4 — root .env.example (contract §2a).
# Copy to `.env` at the repo root and fill in the secrets. The real `.env`
# stays gitignored (root .gitignore already has `*.env`). Do NOT commit
# a filled-in copy. Every variable below is referenced by
# docker-compose.yml; anything not set here falls back to the dev default
# shown in the compose file.
#
# --- Postgres (also used by Temporal: POSTGRES_PWD) ----------------------
# Password for the `epitomejob` Postgres user. Compose default if unset:
# epitomejob-dev. Change it before any shared deployment.
POSTGRES_PASSWORD=epitomejob-dev

# --- Backend -------------------------------------------------------------
# JWT signing secret (application.yml: app.jwt.secret). Compose default if
# unset: dev-only-secret-change-me — REPLACE with a long random secret
# before any shared deployment; the W3 default is a placeholder.
APP_JWT_SECRET=dev-only-secret-change-me

# --- Billing (W4 module M14; flag OFF by default) ------------------------
# BILLING_ENABLED=false: every /billing/** route except /billing/status
# returns 404 and the web plans page shows the billing-off message.
BILLING_ENABLED=false
# stripe | fake. `fake` is for tests and the explicit local-dev demo only;
# it must never be the default. When enabled + stripe but no secret key
# is set, POST /billing/checkout returns 503 BILLING_NOT_CONFIGURED.
BILLING_PROVIDER=stripe
# Stripe secret key (empty = not configured). No Stripe account exists
# yet — leave empty until Stripe is linked; nothing in W4 requires it.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret, for POST /billing/webhook verification.
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key. Reserved for the web Stripe.js step (later
# phase); no compose service reads it in W4.
STRIPE_PUBLISHABLE_KEY=
# Public URL of the web app, used for Stripe Checkout success/cancel
# redirects (/plans?checkout=success|cancelled). Local default:
# http://localhost:3000. Only read when billing is enabled with Stripe.
APP_PUBLIC_URL=http://localhost:3000

# --- Not in this file (dev defaults live in docker-compose.yml) -----------
# MINIO / RustFS credentials (minioadmin / minioadmin-dev), Ollama
# (host.docker.internal:11434), and the agent-brain model names
# (llama3.1:8b / nomic-embed-text) are dev defaults in the compose file.
